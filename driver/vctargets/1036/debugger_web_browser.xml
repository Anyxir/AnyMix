<Rule Name="WebBrowserDebugger" DisplayName="Débogueur de navigateur web" PageTemplate="debugger" Description="Options du débogueur de navigateur web" xmlns="http://schemas.microsoft.com/build/2009/properties">
  <Rule.DataSource>
    <DataSource Persistence="UserFile"/>
  </Rule.DataSource>
  <StringProperty Name="WebBrowserDebuggerHttpUrl" DisplayName="URL HTTP" Description="Spécifie l'URL d'accès au projet." F1Keyword="VC.Project.VCDebugSettings.WebBrowser.WebBrowserDebuggerHttpUrl"/>
  <EnumProperty Name="WebBrowserDebuggerDebuggerType" DisplayName="Type de débogueur" Description="Spécifie le débogueur utilisé. Lorsqu'il a la valeur Automatique, le type de débogueur est choisi en fonction du contenu du fichier exe." F1Keyword="VC.Project.VCDebugSettings.WebBrowser.DebuggerType">
    <EnumValue Name="NativeOnly" DisplayName="Natif uniquement" Description="Natif uniquement"/>
    <EnumValue Name="ManagedOnly" DisplayName="Managé uniquement" Description="Managé uniquement"/>
    <EnumValue Name="Mixed" DisplayName="Mixte" Description="Mixte"/>
    <EnumValue Name="Auto" DisplayName="Auto" Description="Auto"/>
    <EnumValue Name="Script" DisplayName="Script" Description="Script"/>
  </EnumProperty>
</Rule>
