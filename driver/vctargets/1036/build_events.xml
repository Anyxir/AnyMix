<Rule Name="ConfigurationBuildEvents" DisplayName="Événements de build" PageTemplate="tool" Order="90" xmlns="http://schemas.microsoft.com/build/2009/properties">
  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" HasConfigurationCondition="true"/>
  </Rule.DataSource>
  <Rule.Categories>
    <Category Name="PreBuild" DisplayName="Événement pré-build"/>
    <Category Name="PreLink" DisplayName="Événement avant l'édition des liens"/>
    <Category Name="PostBuild" DisplayName="Événement post-build"/>
  </Rule.Categories>
  <StringProperty Name="PreBuildCommand" Category="PreBuild" DisplayName="Ligne de commande" Description="Spécifie une ligne de commande pour l'outil d'événement pré-build à exécuter." F1Keyword="VC.Project.IVCEventTool.CommandLine">
    <StringProperty.ValueEditors>
      <ValueEditor EditorType="DefaultCommandPropertyEditor" DisplayName="&lt;Modifier...&gt;"/>
    </StringProperty.ValueEditors>
    <StringProperty.DataSource>
      <DataSource Persistence="ProjectFile" HasConfigurationCondition="true" ItemType="PreBuildEvent" PersistedName="Command"/>
    </StringProperty.DataSource>
  </StringProperty>
  <StringProperty Name="PreBuildMessage" Category="PreBuild" DisplayName="Description" Description="Spécifie une description de l'outil d'événement pré-build à afficher." F1Keyword="VC.Project.IVCEventTool.Description">
    <StringProperty.DataSource>
      <DataSource Persistence="ProjectFile" HasConfigurationCondition="true" ItemType="PreBuildEvent" PersistedName="Message"/>
    </StringProperty.DataSource>
  </StringProperty>
  <BoolProperty Name="PreBuildEventUseInBuild" Category="PreBuild" DisplayName="Utilisation dans la génération" Description="Spécifie si cet événement de build est exclu de la génération pour la configuration actuelle." F1Keyword="VC.Project.IVCEventTool.ExcludedFromBuild">
  </BoolProperty>

  <StringProperty Name="PreLinkCommand" Category="PreLink" DisplayName="Ligne de commande" Description="Spécifie une ligne de commande pour l'outil d'événement avant l'édition des liens à exécuter." F1Keyword="VC.Project.IVCEventTool.CommandLine">
    <StringProperty.ValueEditors>
      <ValueEditor EditorType="DefaultCommandPropertyEditor" DisplayName="&lt;Modifier...&gt;"/>
    </StringProperty.ValueEditors>
    <StringProperty.DataSource>
      <DataSource Persistence="ProjectFile" HasConfigurationCondition="true" ItemType="PreLinkEvent" PersistedName="Command"/>
    </StringProperty.DataSource>
  </StringProperty>
  <StringProperty Name="PreLinkMessage" Category="PreLink" DisplayName="Description" Description="Spécifie une description de l'outil d'événement avant l'édition des liens à afficher." F1Keyword="VC.Project.IVCEventTool.Description">
    <StringProperty.DataSource>
      <DataSource Persistence="ProjectFile" HasConfigurationCondition="true" ItemType="PreLinkEvent" PersistedName="Message"/>
    </StringProperty.DataSource>
  </StringProperty>
  <BoolProperty Name="PreLinkEventUseInBuild" Category="PreLink" DisplayName="Utilisation dans la génération" Description="Spécifie si cet événement de build est exclu de la génération pour la configuration actuelle." F1Keyword="VC.Project.IVCEventTool.ExcludedFromBuild">
  </BoolProperty>

  <StringProperty Name="PostBuildCommand" Category="PostBuild" DisplayName="Ligne de commande" Description="Spécifie une ligne de commande pour l'outil d'événement post-build à exécuter." F1Keyword="VC.Project.IVCEventTool.CommandLine">
    <StringProperty.ValueEditors>
      <ValueEditor EditorType="DefaultCommandPropertyEditor" DisplayName="&lt;Modifier...&gt;"/>
    </StringProperty.ValueEditors>
    <StringProperty.DataSource>
      <DataSource Persistence="ProjectFile" HasConfigurationCondition="true" ItemType="PostBuildEvent" PersistedName="Command"/>
    </StringProperty.DataSource>
  </StringProperty>
  <StringProperty Name="PostBuildMessage" Category="PostBuild" DisplayName="Description" Description="Spécifie une description de l'outil d'événement post-build à afficher." F1Keyword="VC.Project.IVCEventTool.Description">
    <StringProperty.DataSource>
      <DataSource Persistence="ProjectFile" HasConfigurationCondition="true" ItemType="PostBuildEvent" PersistedName="Message"/>
    </StringProperty.DataSource>
  </StringProperty>
  <BoolProperty Name="PostBuildEventUseInBuild" Category="PostBuild" DisplayName="Utilisation dans la génération" Description="Spécifie si cet événement de build est exclu de la génération pour la configuration actuelle." F1Keyword="VC.Project.IVCEventTool.ExcludedFromBuild">
  </BoolProperty>
</Rule>
