<Rule Name="Microsoft.CodeAnalysis.ClangTidy" PageTemplate="tool" DisplayName="Code Analysis" Order="200" xmlns="http://schemas.microsoft.com/build/2009/properties" xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <Rule.Categories>
    <Category Name="ClangTidy" DisplayName="Clang-Tidy"/>
  </Rule.Categories>
  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" HasConfigurationCondition="true"/>
  </Rule.DataSource>

  <StringProperty Name="ClangTidyChecks" Category="ClangTidy" DisplayName="Vérifications à activer ou désactiver" Description="Spécifie les vérifications à activer/désactiver au moment de l'exécution de clang-tidy. (--checks=[checks])" F1Keyword="vs.codeanalysis.propertypages.native"/>

  <StringProperty Name="ClangTidyToolPath" Category="ClangTidy" DisplayName="Répertoire de l’outil Clang-Tidy" Subtype="folder" Description="Emplacement de clang-tidy.exe" F1Keyword="vs.codeanalysis.propertypages.ClangTidyToolPath"/>

</Rule>
